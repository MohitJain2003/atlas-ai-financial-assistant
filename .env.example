# ============================================================
# Atlas AI Financial Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# All keys marked [REQUIRED] must be set for the bot to work.
# Keys marked [OPTIONAL] add extra capabilities.

# ----------------------------------------------------------
# TELEGRAM (REQUIRED)
# ----------------------------------------------------------
# Get from: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------------------------------------
# AI MODELS — Fallback Chain (set at least 1 REQUIRED)
# ----------------------------------------------------------
# Gemini (REQUIRED - Primary model, best quality + tool calling)
# Get from: https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (REQUIRED - Fast Llama 3.3 70B + voice transcription via Whisper)
# Get from: https://console.groq.com → API Keys → Create key
GROQ_API_KEY=your_groq_api_key_here

# GitHub Models (OPTIONAL - GPT-4o quality, free with GitHub account)
# Get from: https://github.com/settings/tokens → New fine-grained token
# (No special scopes needed — just create any token, models access is automatic)
GITHUB_API_KEY=your_github_personal_access_token_here

# OpenRouter (OPTIONAL - Routes to best available free model automatically)
# Get from: https://openrouter.ai/keys → Create key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI (OPTIONAL)
# Get from: https://console.mistral.ai/api-keys/ → Create key
MISTRAL_API_KEY=your_mistral_api_key_here

# SambaNova Cloud (OPTIONAL - Very fast Llama inference)
# Get from: https://cloud.sambanova.ai/apis → API Keys
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Cerebras Cloud (OPTIONAL - Ultra-fast inference)
# Get from: https://cloud.cerebras.ai/ → API Keys → Create
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ----------------------------------------------------------
# FINANCIAL DATA APIS
# ----------------------------------------------------------
# Finnhub (OPTIONAL but recommended - real-time market news + company news)
# Free tier: 60 calls/minute — more than enough for personal use
# Get from: https://finnhub.io → Sign up → Dashboard → API Key
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage (OPTIONAL - extra financial data source)
# Free tier: 25 calls/day (very limited, use only if needed)
# Get from: https://www.alphavantage.co/support/#api-key → Free API key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ----------------------------------------------------------
# DATABASE (auto-configured, no changes needed)
# ----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./atlas_financial.db

# ----------------------------------------------------------
# BOT SETTINGS (optional overrides)
# ----------------------------------------------------------
BOT_NAME=Atlas
LOG_LEVEL=INFO
